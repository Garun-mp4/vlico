APP_ENV=local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=vlico
POSTGRES_USER=vlico
POSTGRES_PASSWORD=
WEB_PORT=8000
# Use 0.0.0.0 only for deliberate LAN testing with a scoped firewall rule.
WEB_BIND_ADDRESS=127.0.0.1
# Enable delivery after configuring the bot and the agreed recipient.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DELIVERY_ENABLED=false
# SpaceWeb notifications. Set the mailbox password only in the private .env.
EMAIL_DELIVERY_ENABLED=false
LEAD_NOTIFICATION_EMAIL=partners@vlico39.ru
# Set only after confirming the partner recipient; there is no fallback to LEAD_NOTIFICATION_EMAIL.
PARTNER_NOTIFICATION_EMAIL=
EMAIL_HOST=smtp.spaceweb.ru
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=partners@vlico39.ru
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL='VLICO <partners@vlico39.ru>'
YANDEX_ORGANIZATION_ID=164382623295
YANDEX_METRIKA_ID=113716679

# Optional initial editor password; set privately before running create_editor.
VLICO_EDITOR_PASSWORD=

# Public canonical origin; local instances remain noindex.
SITE_URL=https://vlico39.ru
SITE_INDEXABLE=false
# Enable only after configuring goals and consent on production.
ANALYTICS_ENABLED=false
# Operator details shown on legal pages.
OPERATOR_NAME=Индивидуальный предприниматель Гизерский Владлен Владимирович
OPERATOR_INN=390610984618
PRIVACY_EMAIL=i@gizersky.ru
